# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=4000

# PostgreSQL (Cloud SQL in production, local Postgres in dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talctech_rooms

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# File storage (Google Cloud Storage). Leave STORAGE_MODE=mock until a real GCP bucket exists.
STORAGE_MODE=mock
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_PUBLIC_BASE_URL=
# GOOGLE_APPLICATION_CREDENTIALS is read directly by the Google Cloud SDK, not by this app's
# own config - point it at a service account JSON key file when STORAGE_MODE=gcs.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ID Verification (Prembly). Leave PREMBLY_MODE=mock until real credentials exist.
PREMBLY_MODE=mock
PREMBLY_APP_ID=
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com

# Paystack (not yet wired up in Phase 1 scaffold - placeholder for later work)
PAYSTACK_SECRET_KEY=

# Termii SMS (not yet wired up in Phase 1 scaffold - placeholder for later work)
TERMII_API_KEY=
