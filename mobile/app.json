{
  "expo": {
    "name": "TalcTech Rooms",
    "slug": "talctech-rooms",
    "scheme": "talctechrooms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talctech.rooms"
    },
    "android": {
      "package": "com.talctech.rooms",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "TalcTech Rooms needs access to your photos so you can add pictures of your accommodation.",
          "cameraPermission": "TalcTech Rooms needs access to your camera so you can photograph your accommodation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://talctech-rooms-backend-964645423267.africa-south1.run.app"
    }
  }
}
